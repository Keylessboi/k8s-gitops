#!/usr/bin/env python3
"""Relay notifications from the cluster to ntfy on travisbackupserver.

WHY THIS EXISTS. ntfy runs on travisbackupserver, which is on wlo1 behind the
room's WiFi router on a SEPARATE 192.168.1.0/24 - same numbering, different L2
segment. The cluster cannot route to it and its own local subnet route shadows
the tailnet route back (verified both directions 2026-09-03). This host can
reach the cluster (it hosts LXC 200) and can reach travisbackupserver over
Tailscale, so it relays. Same topology reason as homelab-beat-receiver on
:9099, which this deliberately does NOT replace - that one is the dead man's
switch and must stay as dumb as it is.

WHAT IT ACCEPTS
  POST /<topic>                 body + allow-listed headers forwarded to ntfy
  POST /alertmanager/<topic>    an Alertmanager webhook, rendered readable
  POST /                        ntfy's own JSON publish shape, {"topic": ...}
  POST /<topic>?title=..&message=..&priority=..&tags=..
                                query-string form - this is what the *arr
                                apps send (NtfyProxy.cs builds the whole
                                message into the URL and sends an empty body)
  GET  /healthz                 200 for probes

Topics are allow-listed. This binds 0.0.0.0 on a LAN-only port with no auth,
so without the list any host on the LAN could publish to any topic on a server
it cannot otherwise reach.

No dependencies beyond the standard library, on purpose: this runs on the
hypervisor and should never need a package upgrade.
"""
import http.server
import json
import socketserver
import sys
import urllib.error
import urllib.parse
import urllib.request

NTFY = "http://100.81.123.74:2586"
PORT = 9098
TIMEOUT = 12

# Every topic must be listed here AND subscribed on the phone.
#   homelab-alerts  - infrastructure: the things that mean go and look now
#   homelab-media   - the media stack: finished downloads, failed imports
TOPICS = {"homelab-alerts", "homelab-media"}

# Alertmanager severity -> (ntfy priority, tag)
SEVERITY = {
    "critical": ("urgent", "rotating_light"),
    "warning": ("high", "warning"),
    "info": ("default", "information_source"),
}

# Headers worth carrying through. Anything else is dropped rather than
# forwarded blindly - ntfy treats several headers as commands (Delay, Email,
# Call), and this relay has no business issuing those on a caller's behalf.
PASS_HEADERS = ("Title", "Priority", "Tags", "Markdown", "Click", "Icon")

# The same rule for the two other places ntfy reads commands from: the query
# string (delay=, email=, call= work there too, with their short aliases) and
# the JSON publish body. Only the message-shaping fields go through.
PASS_QUERY = {"title", "t", "message", "m", "priority", "prio", "p", "tags",
              "tag", "ta", "markdown", "md", "click", "icon"}
PASS_JSON = {"topic", "message", "title", "priority", "tags", "markdown",
             "click", "icon"}


def safe_query(query):
    pairs = urllib.parse.parse_qsl(query, keep_blank_values=True)
    return urllib.parse.urlencode([(k, v) for k, v in pairs if k.lower() in PASS_QUERY])


def publish(topic, body, headers, query=""):
    # The query string is forwarded (filtered by safe_query): ntfy reads title,
    # message, priority and tags from it, which is the only form some clients
    # send.
    url = f"{NTFY}/{topic}" + (f"?{query}" if query else "")
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return r.status


def render_alertmanager(payload):
    """One ntfy message per Alertmanager group, not per alert.

    Alertmanager already did the grouping; re-expanding it here would turn one
    incident into a burst of notifications, which is the failure mode this
    whole setup is trying to avoid.
    """
    alerts = payload.get("alerts") or []
    if not alerts:
        return None

    status = payload.get("status", "firing")
    first = alerts[0].get("labels", {})
    name = first.get("alertname", "alert")
    severity = first.get("severity", "warning")
    prio, tag = SEVERITY.get(severity, ("high", "warning"))

    if status == "resolved":
        prio, tag = "low", "white_check_mark"
        title = f"Resolved: {name}"
    else:
        title = name if len(alerts) == 1 else f"{name} ({len(alerts)} firing)"

    lines = []
    for a in alerts[:10]:
        lab, ann = a.get("labels", {}), a.get("annotations", {})
        where = lab.get("instance") or lab.get("pod") or lab.get("namespace") or ""
        what = ann.get("description") or ann.get("summary") or lab.get("alertname", "")
        lines.append(f"{where}: {what}".strip(": ") if where else what)
    if len(alerts) > 10:
        lines.append(f"... and {len(alerts) - 10} more")

    return "\n\n".join(lines).encode(), {"Title": title, "Priority": prio, "Tags": tag}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "homelab-ntfy-relay/1"

    def _reply(self, code, text=""):
        body = text.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if urllib.parse.urlsplit(self.path).path == "/healthz":
            return self._reply(200, "ok\n")
        self._reply(404, "not found\n")

    def do_POST(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self._reply(400, "bad Content-Length\n")
        raw = self.rfile.read(length) if length else b""

        # Split the query off BEFORE reading the topic. Lidarr and its
        # siblings put the entire message in the URL -
        # POST /<topic>?title=..&message=..&priority=..&tags=.. with an empty
        # body - so treating self.path as a bare topic rejected every one of
        # them as `unknown topic 'homelab-alerts?title=Lidarr%20-%20Test...'`.
        split = urllib.parse.urlsplit(self.path)
        path, query = split.path, safe_query(split.query)

        # ntfy's JSON publish shape, posted to the root with the topic in the
        # body. Lidarr, Prowlarr and Readarr all send this - their ntfy client
        # takes a server URL and a topic list and never puts the topic in the
        # path, so without this branch they would 404 against the relay.
        if path.strip("/") == "":
            try:
                payload = json.loads(raw or b"{}")
            except ValueError as e:
                return self._reply(400, f"unparseable json: {e}\n")
            if not isinstance(payload, dict):
                return self._reply(400, "json body must be an object\n")
            topic = payload.get("topic")
            if topic not in TOPICS:
                return self._reply(404, f"unknown topic {topic!r}\n")
            try:
                # ntfy's root understands this shape natively, so there is
                # nothing to translate - only fields to drop, as for headers.
                body = json.dumps({k: v for k, v in payload.items() if k in PASS_JSON})
                req = urllib.request.Request(
                    NTFY, data=body.encode(), method="POST",
                    headers={"Content-Type": "application/json"})
                urllib.request.urlopen(req, timeout=TIMEOUT).read()
                return self._reply(204, "")
            except (urllib.error.URLError, OSError) as e:
                print(f"FAILED to publish to {topic}: {e}", file=sys.stderr, flush=True)
                return self._reply(502, f"ntfy unreachable: {e}\n")

        parts = path.strip("/").split("/")
        alertmanager = parts[0] == "alertmanager"
        topic = parts[1] if alertmanager and len(parts) > 1 else parts[0]

        if topic not in TOPICS:
            return self._reply(404, f"unknown topic {topic!r}\n")

        if alertmanager:
            try:
                rendered = render_alertmanager(json.loads(raw or b"{}"))
            except (ValueError, AttributeError) as e:
                return self._reply(400, f"unparseable webhook: {e}\n")
            if rendered is None:
                # A webhook with no alerts is not an error - just nothing to say.
                return self._reply(204, "")
            body, headers = rendered
        else:
            body = raw
            headers = {h: self.headers[h] for h in PASS_HEADERS if self.headers.get(h)}

        try:
            publish(topic, body, headers, query)
            self._reply(204, "")
        except (urllib.error.URLError, OSError) as e:
            # Say so loudly. A relay that swallows its own failures is worse
            # than no relay, because the silence looks identical to "no alerts".
            print(f"FAILED to publish to {topic}: {e}", file=sys.stderr, flush=True)
            self._reply(502, f"ntfy unreachable: {e}\n")

    def log_message(self, *args):
        pass  # journald would fill with successful publishes


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    with Server(("0.0.0.0", PORT), Handler) as httpd:
        httpd.serve_forever()
