[Unit]
Description=Homelab external watchdog (pve + k3s, alerting outside the failure domain)
Documentation=file:///home/travis/k8s-gitops/docs/recovery/cluster-down.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/homelab-external-watchdog
Restart=always
RestartSec=10
DynamicUser=yes
# Survives restarts and reboots so a flapping service cannot re-alert on
# every start; DynamicUser makes this /var/lib/private/<name> with a symlink.
StateDirectory=homelab-external-watchdog
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
