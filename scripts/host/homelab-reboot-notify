#!/usr/bin/env bash
# Runs after apt-daily-upgrade on pve and travisbackupserver (systemd drop-in
# apt/apt-daily-upgrade.service.d/homelab-reboot-notify.conf). When an
# unattended upgrade leaves /run/reboot-required, say so on ntfy - once per
# distinct set of packages, not every day. Never reboots anything.
#
# Not installed in CT 200: a container has no kernel to reboot into, and it
# cannot reach ntfy directly (docs/ntfy.md).
set -uo pipefail
NTFY=http://100.81.123.74:2586/homelab-alerts
STATE=/var/lib/homelab-reboot-notify/last

[ -e /run/reboot-required ] || exit 0
pkgs=$(sort -u /run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ')
sig=$(printf '%s' "$pkgs" | sha256sum | cut -c1-16)
mkdir -p "${STATE%/*}"
[ "$(cat "$STATE" 2>/dev/null)" = "$sig" ] && exit 0

if curl -fsS -m 15 -H "Title: $(hostname): reboot pending" -H "Priority: low" \
     -H "Tags: package" -d "Unattended upgrades want a reboot for: ${pkgs:-unknown}" \
     "$NTFY" >/dev/null; then
  echo "$sig" > "$STATE"
else
  echo "ntfy publish failed" >&2
fi
exit 0
