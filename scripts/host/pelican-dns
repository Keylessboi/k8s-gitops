#!/usr/bin/env python3
"""Publish DNS at Porkbun for each Pelican game server.

Sibling to pelican-portmap, and deliberately a daemon rather than a panel
plugin: the panel runs in k8s from an image, so anything a plugin writes into
its container is lost on the next pod restart. This survives that, and does not
depend on the beta plugin API staying still.

What it actually buys you is the SRV record. *.sandstorm.chat is already a
wildcard A record, so names resolve with or without this - but a Minecraft
client only drops the ":25566" from an address if an SRV record tells it the
port. Source engine games ignore SRV entirely (their client defaults to 27015),
so for those only the A record is managed and anything off 27015 stays host:port.

Inert until PORKBUN_API_KEY / PORKBUN_SECRET_KEY are present, the same way the
qBittorrent upload hook no-ops without its WebDAV credentials.

Safety: it only ever deletes records whose id it recorded in STATE_FILE when it
created them. A record made by hand in the Porkbun console is never touched,
even if its name collides with a server.
"""

import json
import os
import re
import subprocess
import sys
import time
import urllib.request

API = "https://api.porkbun.com/api/json/v3"
DOMAIN = "sandstorm.chat"
INTERVAL = 300
STATE_FILE = "/var/lib/pelican-dns/created.json"
TTL = "600"

# Egg-name fragments whose servers speak the Minecraft handshake, and so can be
# addressed without a port via SRV.
MC_MARKERS = ("minecraft", "paper", "purpur", "spigot", "forge", "fabric",
              "velocity", "bungeecord", "waterfall", "sponge", "vanilla")

SQL = """
SELECT s.name, e.name AS egg, a.port, COALESCE(a.ip_alias, '')
FROM servers s
JOIN eggs e ON e.id = s.egg_id
JOIN allocations a ON a.id = s.allocation_id
"""


def log(msg):
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", flush=True)


def creds():
    k, s = os.environ.get("PORKBUN_API_KEY"), os.environ.get("PORKBUN_SECRET_KEY")
    return (k, s) if k and s else (None, None)


def api(path, payload, timeout=30):
    body = json.dumps(payload).encode()
    req = urllib.request.Request(f"{API}/{path}", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def slugify(name, alias):
    """Prefer the allocation's ip_alias - it is the address already shown in the
    panel, so the DNS we publish matches what the operator already sees."""
    if alias.endswith("." + DOMAIN):
        return alias[: -(len(DOMAIN) + 1)]
    s = re.sub(r"[^a-z0-9-]+", "-", name.lower()).strip("-")
    return s or None


def servers():
    out = subprocess.run(
        ["kubectl", "exec", "-n", "databases", "app-databases-1", "-c", "postgres",
         "--", "psql", "-d", "pelican", "-At", "-F", "\x1f", "-c", SQL],
        capture_output=True, text=True, timeout=60)
    if out.returncode != 0:
        return None
    rows = []
    for line in out.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\x1f")
        if len(parts) != 4:
            continue
        name, egg, port, alias = parts
        slug = slugify(name, alias)
        if slug:
            rows.append({"slug": slug, "egg": egg, "port": int(port),
                         "minecraft": any(m in egg.lower() for m in MC_MARKERS)})
    return rows


def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE_FILE)


def sync(key, secret):
    rows = servers()
    if rows is None:
        log("cannot read the Pelican database; skipping cycle")
        return
    auth = {"apikey": key, "secretapikey": secret}

    ping = api("ping", auth)
    if ping.get("status") != "SUCCESS":
        log(f"Porkbun rejected the credentials: {ping.get('message')}")
        return
    ext_ip = ping.get("yourIp")

    existing = api(f"dns/retrieve/{DOMAIN}", auth)
    if existing.get("status") != "SUCCESS":
        log(f"could not list records: {existing.get('message')}")
        return
    have = {(r["name"], r["type"]): r["id"] for r in existing.get("records", [])}

    state = load_state()
    wanted = {}

    for s in rows:
        fqdn = f"{s['slug']}.{DOMAIN}"
        wanted[(fqdn, "A")] = {"name": s["slug"], "type": "A",
                               "content": ext_ip, "ttl": TTL}
        if s["minecraft"]:
            srv = f"_minecraft._tcp.{s['slug']}"
            wanted[(f"{srv}.{DOMAIN}", "SRV")] = {
                "name": srv, "type": "SRV", "ttl": TTL, "prio": "0",
                # Porkbun carries priority separately; content is weight/port/target.
                "content": f"5 {s['port']} {fqdn}",
            }

    for keyt, rec in wanted.items():
        if keyt in have:
            continue
        res = api(f"dns/create/{DOMAIN}", {**auth, **rec})
        if res.get("status") == "SUCCESS":
            state[f"{keyt[0]}|{keyt[1]}"] = str(res.get("id"))
            log(f"created {rec['type']} {keyt[0]} -> {rec['content']}")
        else:
            log(f"FAILED {rec['type']} {keyt[0]}: {res.get('message')}")

    for skey, rid in list(state.items()):
        nm, typ = skey.rsplit("|", 1)
        if (nm, typ) in wanted:
            continue
        res = api(f"dns/delete/{DOMAIN}/{rid}", auth)
        if res.get("status") == "SUCCESS":
            log(f"removed {typ} {nm} (server gone)")
            state.pop(skey, None)
        else:
            log(f"could not remove {typ} {nm}: {res.get('message')}")

    save_state(state)


def main():
    once = "--once" in sys.argv
    while True:
        key, secret = creds()
        if not key:
            log("PORKBUN_API_KEY/PORKBUN_SECRET_KEY not set - nothing to do. "
                "Enable API access for the domain in the Porkbun console, then "
                "put the pair in /etc/pelican-dns.env.")
        else:
            try:
                sync(key, secret)
            except Exception as exc:
                log(f"cycle error: {exc}")
        if once:
            return 0
        time.sleep(INTERVAL)


if __name__ == "__main__":
    sys.exit(main())
