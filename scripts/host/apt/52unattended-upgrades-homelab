// Homelab unattended-upgrades policy for the Debian 13 hosts: pve, vmhub-1, the
// k3s LXC (CT 200), the vmhub CTs (3000, 3010) and travisbackupserver.
// See docs/host-updates.md and ADR-0014.
//
// Install: apt-get install unattended-upgrades, then copy this file and
// 20auto-upgrades-homelab into /etc/apt/apt.conf.d/.
//
// Replaces the stock origin list rather than appending to it.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        // Debian stable, point releases, and security.
        "origin=Debian,codename=${distro_codename},label=Debian";
        "origin=Debian,codename=${distro_codename}-updates,label=Debian";
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
        // Tailscale: its Release file has no Origin/Label, so match the host.
        "site=pkgs.tailscale.com";
        // Accepted risk, owner decision 2026-10-30 (ADR-0014): a missed patch
        // during a zero-day wave costs more than a bad update. These were manual
        // before; each is still undone by pinning the package (see the doc).
        //  - Proxmox (pve-manager, the pve kernel, qemu, lxc). Proxmox advises
        //    against unattended upgrades; mitigated by the homelab-reboot-window
        //    checks and by pve being the only thing that runs CT 200.
        "origin=Proxmox,codename=${distro_codename}";
        //  - Docker: an upgrade restarts dockerd and every container on the host
        //    (immich-ml on the backup server).
        "site=download.docker.com";
        //  - NVIDIA container toolkit (backup server GPU).
        "site=nvidia.github.io";
};

// Keep the existing config files when a package ships a new one; without this
// a conffile prompt (Proxmox ships several) aborts the run unattended.
Dpkg::Options {
        "--force-confdef";
        "--force-confold";
};

// Never reboot from here. homelab-reboot-window decides, in its own window and
// after per-role safety checks; homelab-reboot-notify still tells ntfy.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::SyslogEnable "true";
